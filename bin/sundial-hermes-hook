#!/usr/bin/env python3
"""sundial-hermes-hook — generic protocol adapter for Hermes (Task 5).

stdin JSON (per docs/superpowers/specs/2026-08-26-universal-backend-design.md):
  {"event": "session_start" | "prompt_submit" | "tick",
   "prompt": "...", "machine": true|false}

stdout: context block to inject. Exit 0 ALWAYS.

SUNDIAL_DATA_DIR env repoints the ledger directory for isolated testing;
unset, the engine's default data/ path is used.

Machine events (caller-asserted `machine: true`, or Claude-Code-style
markers in the prompt head) never disarm asks, never stamp last_prompt,
never refresh the session claim.
"""

import json
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))
sys.path.insert(0, str(REPO / "hooks"))

import core  # noqa: E402

# Test/instance isolation: SUNDIAL_DATA_DIR repoints the engine's ledger
# directory BEFORE any reads (call-time derivation makes this safe — the
# incident #6 rule is exactly what allows this repointing to work).
if __import__("os").environ.get("SUNDIAL_DATA_DIR"):
    core.DATA = Path(__import__("os").environ["SUNDIAL_DATA_DIR"])

MACHINE_MARKERS = ("<task-notification>", "[SYSTEM NOTIFICATION")
AWAY_TAIL = re.compile(r"\s*\(disable recaps.*?\)\s*$", re.I)


def is_machine_event(payload: dict) -> bool:
    if payload.get("machine") is True:
        return True
    head = str(payload.get("prompt") or "").lstrip()[:400]
    return any(m in head for m in MACHINE_MARKERS)


def session_start_block() -> str:
    """Build via the canonical hook builder (reuse, never duplicate)."""
    import session_start as cc_hook
    birth = core.get_or_create_birth()
    _row, previous, _created = core.start_session("hermes", "hermes-hook")
    return cc_hook.build_block(core, birth, previous)


def prompt_tick(payload: dict) -> str:
    """Human-prompt path: disarm + stamp + tick. Mirrors prompt_submit's
    build_context contract; machine events never reach here."""
    import prompt_submit as ps_hook
    return ps_hook.build_context(core, payload)


def main() -> None:
    raw = "" if sys.stdin.isatty() else sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else None
    except ValueError:
        payload = None
    # Corrupt or empty input is AMBIGUOUS input: silence is the fail-safe
    # default (a mis-parsed tick must never fire a full session block).
    if not isinstance(payload, dict):
        return
    if not payload.get("event"):
        return

    event = payload["event"]

    out = ""
    try:
        if event == "session_start":
            out = session_start_block()
        elif event == "prompt_submit":
            if not is_machine_event(payload):
                out = prompt_tick(payload)
            # machine prompts: silent no-op by design
        # unknown events: silent, exit 0
    except Exception:
        out = ""  # fail-safe: a clock bug never blocks anything

    if out:
        sys.stdout.write(out + "\n")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
